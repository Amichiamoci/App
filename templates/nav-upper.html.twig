<nav class="upper border-bottom w-100 position-fixed top-0 bg-body-tertiary overflow-hidden">
    <div class="row w-100">
        <div class="col col-2 p-1 d-flex justify-content-center align-items-center">
            <span></span>
        </div>
        <a class="d-block col col-8 px-4" href="{{ path('home') }}">
            <img src="{{ asset('logos/logo.png') }}" 
                height="75"
                alt="Logo di Amichiamoci" 
                title="Vai alla home" 
                class="w-100 h-auto mx-auto my-0"
            />
        </a>
        <div 
            class="col col-2 p-1 d-flex justify-content-center align-items-center"
            {{ stimulus_controller('theme') }}
        >
            <a  class="text-reset link-underline link-underline-opacity-0 hide-if-same-theme" 
                href="#"
                data-turbo="false"
                data-bs-theme-value="light"
            >
                <twig:ux:icon name="bi:moon" height="25" />
            </a>
            <a  class="text-reset link-underline link-underline-opacity-0 hide-if-same-theme" 
                href="#"
                data-turbo="false"
                data-bs-theme-value="dark"
            >
                <twig:ux:icon name="bi:brightness-high" height="25" />
            </a>
        </div>
    </div>
</nav>

{% if is_granted('IS_AUTHENTICATED_FULLY') and app.user.isAdmin() %}
    <div class="modal fade" 
        id="refereeModal" 
        tabindex="-1" 
        aria-labelledby="refereeModalLabel" 
        aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="refereeModalLabel">
                        Menù amministratore
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a  class="link-underline link-underline-opacity-0 text-reset" 
                                href="{{ path('admin') }}"
                                title="Aggiungi o rimuovi gli amministratori"
                            >
                                <twig:ux:icon name="ri:admin-line" height="18" />
                                &nbsp;
                                Menù Amministratore
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endif %}