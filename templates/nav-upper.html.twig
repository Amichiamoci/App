<nav class="upper border-bottom w-100 position-fixed top-0 bg-body-tertiary overflow-hidden">
    <div class="row w-100">
        <div class="col col-2 p-1 d-flex justify-content-center align-items-center">
            {% if is_granted('IS_AUTHENTICATED_FULLY') and app.user.isReferee() %}
                <div class="d-flex align-items-center ">
                    <button 
                        class="btn btn-link link-underline link-underline-opacity-0 text-reset"
                        type="button" 
                        data-bs-toggle="modal"
                        data-bs-target="#refereeModal"
                    >
                        <twig:ux:icon name="game-icons:whistle" height="25" />
                    </button>
                </div>
            {% endif %}
        </div>
        <a class="d-block col col-8 px-4" href="{{ path('home') }}">
            <img src="{{ asset('logos/logo.png') }}" 
                height="75"
                alt="Logo di Amichiamoci" 
                title="Vai alla home" 
                class="w-100 h-auto mx-auto my-0"
            />
        </a>
        <div 
            class="col col-2 p-1 d-flex justify-content-center align-items-center"
            {{ stimulus_controller('theme') }}
        >
            <a  class="text-reset link-underline link-underline-opacity-0 hide-if-same-theme" 
                href="#"
                data-turbo="false"
                data-bs-theme-value="light"
            >
                <twig:ux:icon name="bi:moon" height="25" />
            </a>
            <a  class="text-reset link-underline link-underline-opacity-0 hide-if-same-theme" 
                href="#"
                data-turbo="false"
                data-bs-theme-value="dark"
            >
                <twig:ux:icon name="bi:brightness-high" height="25" />
            </a>
        </div>
    </div>
</nav>

{% if is_granted('IS_AUTHENTICATED_FULLY') and app.user.isReferee() %}
    <div class="modal fade" 
        id="refereeModal" 
        tabindex="-1" 
        aria-labelledby="refereeModalLabel" 
        aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="refereeModalLabel">
                        Menù {% if app.user.isAdmin() %}amministratore{% else %}arbitro{% endif %}
                    </h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a  class="link-underline link-underline-opacity-0 text-reset" 
                                href="{{ path('referee_dashboard') }}"
                                title="Vedi le partite"
                            >
                                <twig:ux:icon name="fluent:run-16-regular" height="18" />
                                &nbsp;
                                Partite
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a  class="link-underline link-underline-opacity-0 text-reset" 
                                href="{{ path('referee_teams') }}"
                                title="Tutte le squadre"
                            >
                                <twig:ux:icon name="fluent-mdl2:teamwork" height="18" />
                                &nbsp;
                                Squadre
                            </a>
                        </li>
                        {% if app.user.isAdmin() %}
                            <li class="list-group-item">
                                <a  class="link-underline link-underline-opacity-0 text-reset" 
                                    href="{{ path('new_referee') }}"
                                    title="Aggiungi o rimuovi gli arbitri"
                                >
                                    <twig:ux:icon name="material-symbols:add-task-rounded" height="18" />
                                    &nbsp;
                                    Gestisci Arbitri
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a  class="link-underline link-underline-opacity-0 text-reset" 
                                    href="{{ path('admin') }}"
                                    title="Aggiungi o rimuovi gli amministratori"
                                >
                                    <twig:ux:icon name="ri:admin-line" height="18" />
                                    &nbsp;
                                    Gestisci Amministratori
                                </a>
                            </li>
                            <li class="list-group-item">
                                <a  class="link-underline link-underline-opacity-0 text-reset" 
                                    href="{{ path('all_users') }}"
                                    title="Vedi tutti gli utenti"
                                >
                                    <twig:ux:icon name="clarity:users-line" height="18" />
                                    &nbsp;
                                    Tutti gli utenti
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endif %}