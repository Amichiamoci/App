<!DOCTYPE html>
<html lang="it-it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="{% block description %} App Amichiamoci {% endblock %}" />
    <meta name="keywords" content="Amichiamoci, Livorno, Chiesa, Diocesi, Giovani, Sport" />

    <link rel="icon" href="{{ asset('logos/favicon.png') }}" />
    <link rel="shortcut icon" href="{{ asset('logos/favicon.png') }}" />
    
    <title>
        {% block title %}Benvenuto{% endblock %} 
        - Amichiamoci
    </title>
    {% block stylesheets %}{% endblock %}

    {{ pwa() }}
</head>
<body>
    <header class="border border-1 border-left-0 overflow-x-hidden overflow-y-auto">
        {% include('nav.html.twig') %}
    </header>

    <div class="container ps-2 pe-2 overflow-auto" id="content">
        {% include('mobile-nav-upper.html.twig') %}

        <main role="main" class="pt-3 pb-3">
            {% for flash in app.flashes('success') %}
                <div class="alert alert-success" role="alert">{{ flash }}</div>
            {% endfor %}

            {% for flash in app.flashes('error') %}
                <div class="alert alert-danger" role="alert">{{ flash }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-top text-muted user-select-none mt-auto mb-0 pb-1 w-100 overflow-hidden">
            {% include('footer.html.twig') %}
        </footer>
    </div>
    
    <button type="button"
            class="btn btn-secondary btn-floating btn-lg d-none position-fixed z-3"
            data-btn-to-top="true"
            style="bottom: 20px; right: 20px;"
            title="Torna su">
        <twig:ux:icon name="bi:arrow-up" width="16" />
    </button>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</body>
</html>
