<!DOCTYPE html>
<html dir="ltr" lang="it-it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="{% block description %}App Amichiamoci{% endblock %}" />
    <meta name="keywords" content="Amichiamoci, Livorno, Chiesa, Diocesi, Giovani, Sport" />

    <link rel="icon" href="{{ asset('logos/favicon.png') }}" />
    <link rel="shortcut icon" href="{{ asset('logos/favicon.png') }}" />
    
    <title>
        {% block title %}Benvenuto{% endblock %} 
        - Amichiamoci
    </title>
    {% block stylesheets %}{% endblock %}

    {% include('offline/game-preload.html.twig') %}

    {{ pwa() }}
</head>
<body class="p-0 m-0" {{ stimulus_controller('offline-game') }}>
    {% include('transition.html.twig') %}
    
    <header class="border border-1 border-left-0 overflow-x-hidden overflow-y-auto">
        {% include('aside.html.twig') %}
    </header>

    <div class="container p-0 overflow-y-auto position-relative" id="content">
        {% include('nav-upper.html.twig') %}

        <main role="main" class="w-100 pt-3 pb-4 ps-1 pe-1 position-absolute">
            {% for flash in app.flashes('success') %}
                <div class="alert alert-success d-flex align-items-center" role="alert">
                    <twig:ux:icon name="mdi:success-circle" height="25" />
                    <div>{{ flash }}</div>
                </div>
            {% endfor %}

            {% for flash in app.flashes('warn') %}
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    {#<twig:ux:icon name="material-symbols:warning" height="25" />#}
                    <div>{{ flash }}</div>
                </div>
            {% endfor %}

            {% for flash in app.flashes('error') %}
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <twig:ux:icon name="material-symbols:error" height="25" />
                    <div>{{ flash }}</div>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
            
            {#
            <div class="mx-auto max-w-screen-xl text-center px-4" 
                {{ stimulus_controller('@pwa/connection-status', {'onlineMessage': 'Sei online', 'offlineMessage': 'Connessione a internet assente!'}) }}
            >
                <div
                    {{ stimulus_target('@pwa/connection-status', 'attribute') }}
                    class="alert align-items-center online:d-none online:alert-success offline:d-flex offline:alert-warning offline:fw-bold"
                    role="alert"
                >
                    <span {{ stimulus_target('@pwa/connection-status', 'message') }}>
                        Stiamo cercando di verficiare lo stato 
                        della connessione a internet 
                    </span>
                </div>
            </div>
            #}
        </main>

        {% include('offline/alert.html.twig') %}
        {% include('offline/game-body.html.twig') %}

        {% include('nav-lower.html.twig') %}

        <footer class="border-top bg-body-secondary user-select-none position-fixed bottom-0 pb-1 w-100 z-3 overflow-hidden">
            {% include('footer.html.twig') %}
        </footer>
    </div>
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

</body>
</html>
