{% extends 'base.html.twig' %}

{% block title %}Torneo {{ tournament.Name }}{% endblock %}
{% block description %}Torneo di {{ tournament.Sport }}{% endblock %}

{% block body %}
    <div class="m-1">
        <h1>
            Torneo {{ tournament.Name }}
        </h1>
        <p>
            Tipologia: <strong>{{ tournament.Type }}</strong><br />
            Sport: {{ tournament.Sport }}<br />
            Squadre partecipanti: <output>{{ tournament.Teams|length }}</output>
        </p>

        <hr />
        
        {#
        <h3>
            Squadre partecipanti
        </h3>
        <ul class="list-group">
            {% for teamName in tournament.Teams %}
                <li class="list-group-item">{{ teamName }}</li>
            {% endfor %}
        </ul>
        
        <hr />
        #}

        {% if tournament.hasLeaderboard() %}
            <h3> Classifica </h3>
            <table class="table">
            <thead>
                <tr>
                    <th rowspan="2" class="align-middle"> Squadra </th>
                    <th rowspan="2" class="align-middle"> Punti </th>
                    <th colspan="2" class="text-center"> Partite </th>
                </tr>
                <tr>
                    <th>
                        Da Giocare
                    </th>
                    <th>
                        Previste
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for team in tournament.Leaderboard %}
                    <tr>
                        <td>
                            <a href="{{ path ('home_team_view', {'id': team.Id }) }}"
                                class="link-underline link-underline-opacity-0"
                                title="{{ team.Church }}"
                            >
                                {{ team.Name }}
                            </a>
                        </td>
                        <td>
                            <output>{{ team.Points }}</output>
                        </td>
                        <td>
                            <output>{{ team.MatchesToPlay }}</output>
                        </td>
                        <td>
                            <output>{{ team.PlannedMatches }}</output>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            </table>

            <hr />
        {% endif %}

        <h3>
            Parite ({{ tournament.Matches|length }})
        </h3>
        <div class="row">
            {% for match in tournament.Matches %}
                <div class="col col-xs-12 col-sm-6 col-lg-4 mb-2">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-title">
                                <a href="{{ path('home_team_view', {'id': match.HomeTeam.Id })}}" 
                                    class="link-underline link-underline-opacity-0"
                                    title="{{ match.HomeTeam.Church }}"
                                >
                                    {{ match.HomeTeam.Name }}
                                </a>
                                - 
                                <a href="{{ path('home_team_view', {'id': match.GuestTeam.Id })}}" 
                                    class="link-underline link-underline-opacity-0"
                                    title="{{ match.GuestTeam.Church }}"
                                >
                                    {{ match.GuestTeam.Name }}
                                </a>
                            </div>

                            {% if match.hasScores() %}
                                <p class="text-muted user-select-none">
                                    {{ match.ScoresRow }}
                                </p>
                            {% elseif match.hasDate() %}
                                <p class="text-muted user-select-none">
                                    Prevista per il {{ match.Date }}
                                </p>
                            {% endif %}
                       </div>
                    </div> 
                </div>
            {% else %}
                <p class="list-group-item">
                    Calendario non ancora creato
                </p>
            {% endfor %}
        </div>
    </div>
{% endblock %}