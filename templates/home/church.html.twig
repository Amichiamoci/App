{% extends 'base.html.twig' %}

{% block title %}Parrocchia {{ church.Name }}{% endblock %}
{% block description %}La parrocchia {{ church.Name }} della Diocesi di Livorno{% endblock %}

{% block body %}
    <div class="card">
        <h3 class="card-title m-1">
            Parrocchia {{ church.Name }}
        </h3>
        
        <div class="card-body">
            {% if church.hasAddress() %}
                <a href="#" class="card-link">{{ church.Address }}</a>
            {% endif %}

            {% if church.hasWebsite() %}
                <a  href="{{ church.Website }}" 
                    class="card-link" 
                    target="_blank" 
                    title="Sito web della parrocchia"
                >
                    {{ church.Website }}
                </a>
            {% endif %}
        </div>

        <ul class="list-group list-group-flush">
            {% for staff in church.staff %}
                <li class="list-group-item">
                    {{ staff.Name }}
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}