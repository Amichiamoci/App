{% extends 'base.html.twig' %}

{% block title %}Campi di Amichiamoci{% endblock %}
{% block description %}Dove si svolgeranno le partite per l'edizione {{ 'now' | date('Y') }}{% endblock %}

{% block body %}

    <h1>
        Campi per il {{ 'now' | date('Y') }}
    </h1>

    <div class="row">
        {% for field in fields %}
            <div class="col col-xs-12 col-sm-6 col-lg-4 mb-2">
                <div class="card">
                    <div class="card-body">
                        <div class="card-title">
                            <a  href="{{ path('home_field_view', { 'id': field.Id }) }}"
                                class="link-underline link-underline-opacity-75"
                                title="Vedi i dettagli del campo"
                            >
                                {{ field.Name }}
                            </a>
                        </div>

                        
                        {% if field.hasAddress() %}
                            <p>
                                {{ field.Address }}
                            </p>
                        {% endif %}
                    </div>
                </div>

            </div>
        {% else %}
            <p>
                Nessun campo per l'edizione corrente.
            </p>
        {% endfor %}
    </div>

{% endblock %}
