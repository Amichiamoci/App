<table class="table table-striped table-hover">
   
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col"> Parrocchia </th>
            <th scope="col"> Punti </th>
        </tr>
    </thead>

    <tbody>
        {% for church in leaderboard %}
            <tr>
                <th scope="row">
                    <output class="user-select-none">
                        {{ church.Position }}
                    </otuput>
                </th>
                <td>
                    <a  href="{{ path('church_view', {'id': church.Id })}}" 
                        class="link-underline link-underline-opacity-0"
                        title="Vai alla Parrocchia"
                    >
                        {{ church.Name }}
                    </a>
                </td>
                <td class="text-center">
                    <output class="user-select-none">
                        {{ church.Score }}
                    </output>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">
                    Classifica non ancora disponibile
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>