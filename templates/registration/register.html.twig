{% extends 'base.html.twig' %}

{% block title %}Registrati{% endblock %}
{% block description %}Crea un account{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <h1 class="h3 mb-3 font-weight-normal">Registrati</h1>

    {{ form(registrationForm) }}

    <p class="mb-1 small">
        Hai già un account?
        Accedi
        <a  href="{{ path('app_login') }}" 
            class="link-underline link-underline-opacity-0 link-primary"
            title="Effettua il login"
        >qui</a>.
    </p>

    {% include 'security/external_login.html.twig' with { 'label': 'Registrati' } %}
{% endblock %}
