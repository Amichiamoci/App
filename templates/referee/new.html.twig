{% extends 'base.html.twig' %}

{% block title %}Aggiungi arbitro{% endblock %}
{% block description %}Aggiungi nuovo arbitro{% endblock %}

{% block body %}
    <h3 class="h3 mb-3 font-weight-normal">
        Aggiungi arbitri
    </h3>
    
    {{ form(addRefereeForm) }}

    <div class="row">
        <h4 class="h4 mb-3 font-weight-normal">
            Arbitri presenti
        </h4>
        <ul class="list-group list-group-fulsh">
            {% for referee in referees %}
                <li class="list-group-item">
                    <span class="text-secondary user-select-none">
                        #{{ referee.Id }}
                    </span>

                    {{ referee.Name }}

                    <a href="mailto:{{ referee.Email }}" class="link-secondary link-underline link-underline-opacity-0">
                        <twig:ux:icon name="bi:envelope-at" height="14" />
                    </a>
                    &nbsp;

                    <form class="d-inline m-0 p-0" method="POST" action="{{ path('referee_remove', { 'id': referee.Id }) }}">
                        <button
                            type="submit"
                            class="p-0 btn btn-link link-danger link-underline link-underline-opacity-0"
                            title="Rimuovi dagli arbitri"
                        >
                            <twig:ux:icon name="bi:trash" height="14" />
                        </button>
                    </form>
                </li>
            {% else %}
                <li class="list-group-item">
                    <strong>Nessun arbitro trovato</strong>
                </li>
            {% endfor %}
        </ul>
    </div>

{% endblock %}
