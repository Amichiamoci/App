<div class="card m-1" id="anagrafica-{{ anagraphical.Id }}">
    <div class="card-body">
        <div class="card-title">
            <strong>
                {{ anagraphical.Name }}
            </strong>
            <span class="user-select-none text-secondary">/</span>
            <strong>
                {{ anagraphical.Surname }}
            </strong>

            {% if anagraphical.hasSubscription() %}
                {% set edit_path = path('get_involved', {'id': anagraphical.Id }) %}
            {% else %}
                {% set edit_path = path('signup', {'id': anagraphical.Id }) %}
            {% endif %}

            <a 
                href="{{ edit_path }}"
                class="link-underline link-underline-opacity-0 link-primary text-end"
                title="Modifica i dati"
            >
                <twig:ux:icon name="bi:pencil-square" height="16" />
            </a>
        </div>

        <dl class="row">
        
            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="clarity:id-badge-line" height="15" />
                Codice Fiscale
            </dt>
            <dd class="col-sm-8">
                <output class="text-uppercase text-monospace user-select-none">
                    {{ anagraphical.TaxCode|slice(0, 9) }}*******
                </output>
            </dd>
            
            <dt class="col-4 text-nowrap">
                <twig:ux:icon name="fa:birthday-cake" height="15" />
                {% if anagraphical.Sex == 'F' %}Nata{% else %}Nato{% endif %} il
            </dt>
            <dd class="col-8">
                {{ anagraphical.BirthDateItalian }}
            </dd>

            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="bi:envelope-at" height="15" />
                Email
            </dt>
            <dd class="col-sm-8">
                {% if anagraphical.hasEmail() %}
                    {% if app.user.isReferee() %}
                        <a class="text-reset link-underline link-underline-opacity-0" 
                            href="mailto:{{ anagraphical.Email }}"
                            title="Invia un'email a {{ anagraphical.Name }}"
                        >
                            {{ anagraphical.Email }}
                        </a>
                    {% else %}
                        <span class="user-select-none font-monospace">
                            {{ anagraphical.Email }}
                        </span>
                    {% endif %}
                {% else %}
                    Mancante
                {% endif %}
            </dd>

            {% if anagraphical.hasPhone() %}
                <dt class="col-4 text-nowrap">
                    <twig:ux:icon name="bi:telephone" height="15" />
                    Telefono
                </dt>
                <dd class="col-8">
                    {% if app.user.isReferee() %}
                        <a class="text-reset link-underline link-underline-opacity-0" 
                            href="{{ anagraphical.PhoneLinkHref }}"
                            title="Invia un messaggio a {{ anagraphical.Name }}"
                        >
                            {{ anagraphical.Phone }}
                        </a>
                    {% else %}
                        <span class="user-select-none font-monospace">
                            {{ anagraphical.Phone }}
                        </span>
                    {% endif %}
                </dd>
            {% endif %}

            <dt class="col-4 text-nowrap">
                <twig:ux:icon name="mdi:file-document-outline" height="15" />
                Documento
            </dt>
            <dd class="col-8">
                <button 
                    class="btn btn-link p-0 text-reset"
                    type="button" 
                    data-bs-toggle="popover" 
                    data-bs-trigger="focus" 
                    data-bs-container="body" 
                    data-bs-placement="top" 
                    data-bs-title="{{ anagraphical.Document.Type.Label }}{% if anagraphical.Document.Code %} {{ anagraphical.Document.Code }}{% endif %}"
                    data-bs-content="Scadenza: {{ anagraphical.Document.ExpirationItalian }}"
                    title="{{ anagraphical.Document.Type.Label }}"
                >
                    {{ anagraphical.Document.Type.Label }}
                </button>
            </dd>

            {% if anagraphical.Subscription %}
                <dt class="col-4 text-nowrap">
                    <twig:ux:icon name="bi:card-checklist" height="15" />
                    Iscrizione
                </dt>
                {% if anagraphical.hasStatus() %}
                    <dd class="col-8 text-warning">
                        <twig:ux:icon name="mdi:alert-outline" height="14" />
                        <button
                            class="btn btn-link p-0 font-monospace text-reset"
                            type="button" 
                            data-bs-toggle="popover" 
                            data-bs-trigger="focus" 
                            data-bs-container="body" 
                            data-bs-placement="top" 
                            data-bs-title="Iscrizione non valida"
                            data-bs-content="Ci sono problemi con la tua iscrizione. Finché non saranno risolti non ti sarà possibile scendere in campo."
                            title="Ci sono problemi"
                        >
                            #{{ anagraphical.Subscription.Id }}
                        </button>
                    </dd>
                {% else %}
                    <dd class="col-8 text-success">
                        <twig:ux:icon name="mdi:check-thick" height="14" />
                        <strong class="font-monospace">
                            #{{ anagraphical.Subscription.Id }}
                        </strong>
                    </dd>
                {% endif %}

                <dt class="col-4 text-nowrap">
                    <twig:ux:icon name="la:tshirt" height="15" />
                    Taglia
                </dt>
                <dd class="col-8">
                    {{ anagraphical.Subscription.Shirt }}
                </dd>

                <dt class="col-sm-4 text-nowrap">
                    <twig:ux:icon name="material-symbols:church-outline" height="15" />
                    Parrocchia
                </dt>
                <dd class="col-sm-8">
                    <a href="{{ path('church_view', {'id': anagraphical.Subscription.Church.Id }) }}" 
                        class="text-reset link-underline link-underline-opacity-50"
                        title="Vedi {{ anagraphical.Subscription.Church.Name }}"
                    >
                        {{ anagraphical.Subscription.Church.Name }}
                    </a>
                </dd>
            {% else %}
                <dt class="col-sm-4 text-nowrap">
                    <twig:ux:icon name="bi:card-checklist" height="15" />
                    Iscriviti
                </dt>
                <dd class="col-sm-8">
                    <a href="{{ path('get_involved', {'id': anagraphical.Id }) }}" 
                        class="link-underline-primary link-underline-opacity-75"
                        title="Iscrivi alla manifestazione"
                    >
                        <strong>
                            Clicca qui
                        </strong>
                    </a>
                </dd>
            {% endif %}

            {% for problem, message in anagraphical.Status %}
                <dt class="col-sm-4 text-warning">
                    <twig:ux:icon name="mdi:alert-outline" height="14" />
                    {{ problem }}
                </dt>
                <dd class="col-sm-8">
                    <strong>
                        {{ message }}
                    </strong>
                </dd>
            {% endfor %}
        </dl>
    </div>
</div>