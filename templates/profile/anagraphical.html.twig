<div class="card" id="anagrafica-{{ anagraphical.Id }}">
    <div class="card-body">
        <div class="card-title">
            <strong>
                {{ anagraphical.Name }}
            </strong>
            <span class="user-select-none text-secondary">/</span>
            <strong>
                {{ anagraphical.Surname }}
            </strong>

            <a 
                href="#"
                class="link-underline link-underline-opacity-0 link-primary text-end"
                title="Modifica i dati"
            >
                <twig:ux:icon name="bi:pencil-square" height="16" />
            </a>
        </div>

        <dl class="row">
        
            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="clarity:id-badge-line" height="15" />
                Codice Fiscale
            </dt>
            <dd class="col-sm-8">
                <output class="text-uppercase text-monospace user-select-none">
                    {{ anagraphical.TaxCode|slice(0, 9) }}*******
                </output>
            </dd>
            
            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="fa:birthday-cake" height="15" />
                Nato/a il
            </dt>
            <dd class="col-sm-8">
                {{ anagraphical.BirthDate }}
            </dd>

            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="bi:envelope-at" height="15" />
                Email
            </dt>
            <dd class="col-sm-8">
                {% if anagraphical.hasEmail() %}
                    <a class="text-reset" 
                        href="mailto:{{ anagraphical.Email }}"
                    >
                        {{ anagraphical.Email }}
                    </a>
                {% else %}
                    Mancante
                {% endif %}
            </dd>

            {% if anagraphical.hasPhone() %}
                <dt class="col-sm-4 text-nowrap">
                    <twig:ux:icon name="bi:telephone" height="15" />
                    Telefono
                </dt>
                <dd class="col-sm-8">
                    <a class="text-reset" 
                        href="tel:{{ anagraphical.Phone }}"
                    >
                        {{ anagraphical.Phone }}
                    </a>
                </dd>
            {% endif %}

            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="mdi:file-document-outline" height="15" />
                Documento
            </dt>
            <dd class="col-sm-8">
                <a class="text-reset"
                    data-bs-toggle="modal" 
                    data-bs-target="#identity-modal-{{ anagraphical.Id }}"
                    title="{{ anagraphical.Document.TypeName }}"
                    href="#"
                >
                    {{ anagraphical.Document.TypeName }}
                </a>
                
                <div class="modal fade" id="identity-modal-{{ anagraphical.Id }}" tabindex="-1" aria-labelledby="identity-modal-{{ anagraphical.Id }}-label" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="identity-modal-{{ anagraphical.Id }}-label">
                                    {{ anagraphical.Document.TypeName }}
                                </h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            
                            {% if anagraphical.Document.hasMessage() %}
                                <div class="modal-body">
                                    {{ anagraphical.Document.Message }}
                                </div>
                            {% endif %}

                            <div class="modal-body">
                                Codice {{ anagraphical.Document.TypeName }}:
                                <output class="font-monospace user-select-none">
                                    {{ anagraphical.Document.Code }}
                                </output>
                            </div>
                        </div>
                    </div>
                </div>
            </dd>

            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="bi:card-checklist" height="15" />
                Iscrizione
            </dt>
            <dd class="col-sm-8">
                {{ anagraphical.SubscriptionStatus }}
            </dd>

            <dt class="col-sm-4 text-nowrap">
                <twig:ux:icon name="bi:clipboard2-pulse" height="15" />
                Certificato medico
            </dt>
            <dd class="col-sm-8">
                {{ anagraphical.MedicalCertificate }}
            </dd>

            {% if anagraphical.hasShirtSize() %}
                <dt class="col-sm-4 text-nowrap">
                    <twig:ux:icon name="la:tshirt" height="15" />
                    Taglia
                </dt>
                <dd class="col-sm-8">
                    {{ anagraphical.ShirtSize }}
                </dd>
            {% endif %}

            {% if anagraphical.hasChurch() %}
                <dt class="col-sm-4 text-nowrap">
                    <twig:ux:icon name="material-symbols:church-outline" height="15" />
                    Parrocchia
                </dt>
                <dd class="col-sm-8">
                    <a href="{{ path('church_view', {'id': anagraphical.ChurchId }) }}" 
                        class="link-underline-primary link-underline-opacity-75"
                        title="Vedi {{ anagraphical.Church }}">
                        {{ anagraphical.Church }}
                    </a>
                </dd>
            {% else %}

            {% endif %}
        </dl>
    </div>
</div>