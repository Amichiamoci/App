{% extends 'base.html.twig' %}

{% block title %}Utente{% endblock %}
{% block description %}Il mio account{% endblock %}

{% block body %}

    <h1>
        Il mio account
    </h1>

    <div class="card m-1">
        <div class="card-header font-monospace user-select-none">
            {{ app.user.getName() }}
        </div>
        <div class="card-body">
            <div class="card-title font-monospace user-select-none">
                <twig:ux:icon name="bi:envelope-at" height="15" /> 
                {{ app.user.email }}
            </div>
            {% if app.user.isAdmin() %}
                <h6 class="card-subtitle mb-2 user-select-none text-body-secondary">
                    Amministratore
                </h6>
            {% endif %}
    
            <div class="btn-group" role="group" aria-label="Azioni possibili">
                <a href="{{ path('app_logout') }}" class="btn btn-outline">
                    <span>Esci</span>
                    <twig:ux:icon name="bi:box-arrow-right" height="14" />
                </a>
            </div>
        </div>
    </div>

    {% for anagraphical in anagraphicals %}
        {% include '/profile/anagraphical.html.twig' with { 'anagraphical': anagraphical } %}
    {% else %}
        <div class="alert alert-info align-items-left m-1" role="alert">
            <h2>
                Hai partecipato in passato ma non vedi i tuoi dati?
            </h2>
            <p class="m-0 user-select-none">
                Nessuna anagrafica risulta associata alla mail <otuput>{{ app.user.email }}</output>.<br />
                È possibile che i tuoi dati siano presenti, ma legati ad un'altra email.
                Prova ad 
                <a href="{{ path('app_logout') }}" 
                   class="text-reset link-underline link-underline-opacity-50"
                   title="Esci e rientra con un altro account"
                >accedere con un altro account</a>.
            </p>
        </div>
    {% endfor %}

    <div class="card m-1 mb-3">
        <div class="card-body">
            <h3 class="card-title user-select-none">
                Aggiungi nuovi dati
            </h3>

            <p class="m-0">
                I dati saranno associati all'email 
                <span class="font-monospace user-select-none">{{ app.user.email }}</span>:
                solo con questo account sarà possibile modificarli in futuro.<br />

                In caso di iscrizione di un <strong>minore</strong> è necessario che 
            </p>
            <ol class="list-group list-group-numbered list-group-flush m-0">
                <li class="list-group-item pe-0 d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        Un genitore o un tutore fornisca i dati tramite la stessa procedura
                    </div>
                </li>
                <li class="list-group-item pe-0 d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        Il nome del genitore o del tutore venga comunicato
                        ad uno staffista della propria parrocchia, in modo che questo possa
                        associare i dati di genitore (o tutore) a quelli del/della figlio/a.
                    </div>
                </li>
                <li class="list-group-item pe-0 d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        Un genitore, una volta associato, potrà modificare i dati
                        del/la figlio/a tramite il suo account e fornire eventuali
                        documenti mancanti (come il certificato medico).
                    </div>
                </li>
            </ol>
    
            <a href="{{ path('signup') }}" class="btn btn-primary m-2">
                <span>Aggiungi nuovi dati</span>
                <twig:ux:icon name="bitcoin-icons:sign-outline" height="17" />
            </a>
        </div>

        <div class="card-body">
            <h3 class="card-title user-select-none">
                Il certificato medico
            </h3>
            
            <p>
                Si ricorda che per un'iscrizione valida è
                necessario fornire un certificato medico di livello almeno
                <strong>NON AGONISTICO</strong>.<br />

                <em>Amichiamoci</em> è convenzionata con 
                
                <button 
                    class="btn btn-link p-0 d-inline link-primary link-underline link-underline-opacity-75"
                    type="button" 
                    data-bs-toggle="popover" 
                    data-bs-trigger="focus" 
                    data-bs-container="body" 
                    data-bs-placement="top" 
                    data-bs-title="Centro medico SVS Livorno"
                    data-bs-content="Si trova in via San Giovanni 30"
                    title="Centro medico SVS Livorno"
                >
                    SVS Livorno
                </button>
                
                per le visite di rilascio di certificato medico, sia agonistico, sia non agonistico.<br />

                Per il ottenere certificato sarà necessario presentare compilata la
            </p>
            <a  href="{{ asset('documents/richiesta-certificato-medico.pdf') }}" 
                class="btn btn-primary m-2" 
                download="richiesta-certificato-medico-amichiamoci.pdf"
                title="Scarica il modulo di richiesta del certificato medico"
            >
                <span>Richiesta della Società</span>
                <twig:ux:icon name="fa-regular:file-pdf" height="17" />
            </a>
        </div>
    </div>

{% endblock %}
