{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}
{% block description %}Pannello Amministratore{% endblock %}

{% block body %}
<div class="row">
    <div class="col">
        <h3 class="h3 mb-3 font-weight-normal">
            Aggiungi amministratori
        </h3>

        {{ form(addAdminForm) }}
    </div>
</div>

<div class="row">
    <div class="col">
        <h3 class="h3 mb-3 font-weight-normal">
            Amministratori presenti
        </h3>

        <ul class="list-group list-group-flush">
        {% for user in admins %}
            <li class="list-group-item">
                <span class="text-secondary user-select-none">
                    #{{ user.Id }}
                </span>

                {{ user.Name }}

                <a href="mailto:{{ user.Email }}" class="link-secondary link-underline link-underline-opacity-0">
                    <twig:ux:icon name="bi:envelope-at" height="14" />
                </a>
                &nbsp;

                <form class="d-inline m-0 p-0" method="POST" action="{{ path('admin_remove', { 'id': user.Id }) }}">
                    <button
                        type="submit"
                        class="p-0 btn btn-link link-danger link-underline link-underline-opacity-0"
                        title="Rimuovi dagli amministratori"
                    >
                        <twig:ux:icon name="bi:trash" height="14" />
                    </button>
                </form>
            </li>
        {% else %}
            <li class="list-group-item">
                <strong>Nessun utente: c'è un problema!</strong>
            </li>
        {% endfor %}
        </ul>
    </div>
</div>
    
{% endblock %}
