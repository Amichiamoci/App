{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}
{% block description %}Effettua il login per vedere la pagina{% endblock %}

{% block body %}
    <h1 class="h2 mb-3 font-weight-normal">
        Entra nell'App
    </h1>

    {{ form(loginForm) }}

    <p class="mb-1 small">
        Password dimenticata?
        Clicca
        <a  href="{{ path('app_forgot_password_request') }}" 
            class="link-underline link-underline-opacity-0 link-primary"
            title="Recupera la password"
        >qui</a>.
    </p>

    <h2>
        Non hai un account?
    </h2>
    <p class="mb-1 small">
        Registrati
        <a  href="{{ path('app_register') }}" 
            class="link-underline link-underline-opacity-0 link-primary"
            title="Registrati"
        >qui</a>
        oppure
    </p>

    {% include 'security/external_login.html.twig' with { 'label': 'Accedi' }  %}
{% endblock %}
