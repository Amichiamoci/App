{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}
{% block description %}Effettua il login per vedere la pagina{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-2">
                Sei già loggato come {{ app.user.userIdentifier }},
                <a href="{{ path('app_logout') }}" class="link-primary">Esci</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">
            Effettua il login
        </h1>
        
        <div class="form-floating mb-1">
            <input 
                type="email" 
                value="{{ last_username }}" 
                name="_username" 
                id="username" 
                class="form-control" 
                autocomplete="email" 
                required 
                autofocus 
                placeholder="nome@mail.com">
            <label for="username">Email</label>
        </div>

        <div class="form-floating mb-1">
            <input 
                type="password" 
                name="_password" 
                id="password" 
                class="form-control" 
                autocomplete="current-password" 
                required>
            <label for="password">Password</label>
        </div>

        <div class="form-text mb-1">
            Password dimenticata? Clicca
            <a 
                href="{{ path('app_forgot_password_request') }}" 
                class="link-underline link-underline-opacity-0 link-primary"
                title="Recupera la password">
                qui
            </a>
        </div>
        
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

        <div class="checkbox mb-3">
            <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
            <label for="_remember_me" class="form-check-label">Resta collegato</label>
        </div>

        <button class="btn btn-primary" type="submit">
            Accedi
        </button>
    </form>
    {% include 'security/external_login.html.twig' with { 'label': 'Login' }  %}
{% endblock %}
