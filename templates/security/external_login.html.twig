<h2>
    {{ label }} tramite provider esterni
</h2>

<div class="row m-1">
    <div class="btn-group" 
        role="group" 
        aria-label="{{ label }} tramite provider esterni"
    >
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'google' }) }}" 
            class="btn btn-outline-info" 
            role="button"
        >
            <span>Google</span>
            <twig:ux:icon name="bi:google" height="14" />
        </a>
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'github' }) }}" 
            class="btn btn-outline-info" 
            role="button"
        >
            <span>GitHub</span>
        </a>
        {#
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'facebook' }) }}" 
            class="btn btn-outline-info"
            role="button"
        >
            <span>Facebook</span>
            <twig:ux:icon name="bi:facebook" height="14" />
        </a>
        #}
    </div>
</div>