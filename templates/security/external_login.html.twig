<h2>
    {{ label }} tramite provider esterni
</h2>

<div class="row m-1">
    <div class="btn-group" 
        role="group" 
        aria-label="{{ label }} tramite provider esterni"
    >
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'google' }) }}" 
            class="btn btn-outline" 
            role="button"
        >
            <twig:ux:icon name="logos:google-icon" height="14" />
        </a>
        {#
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'facebook' }) }}" 
            class="btn btn-outline-info"
            role="button"
        >
            <twig:ux:icon name="logos:facebook" height="14" />
        </a>
        #}
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'microsoft' }) }}" 
            class="btn btn-outline-info" 
            role="button"
        >
            <twig:ux:icon name="mdi:microsoft-github" height="14" />
        </a>
        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'github' }) }}" 
            class="btn btn-outline-info" 
            role="button"
        >
            <twig:ux:icon name="logos:microsoft-icon" height="14" />
        </a>
    </div>
</div>