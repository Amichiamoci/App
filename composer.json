{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "amphp/http-client": "^5.1",
        "davidepastore/codice-fiscale": "^0.10.0",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "easycorp/easyadmin-bundle": "^5.0",
        "hwi/oauth-bundle": "^2.5",
        "karser/karser-recaptcha3-bundle": "^0.3.0",
        "liip/imagine-bundle": "^2.15",
        "nicholasricci/anagrafiche-anpr-istat": "^1.1",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.1",
        "spomky-labs/pwa-bundle": "^1.3",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "^8.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/console": "^8.0",
        "symfony/doctrine-messenger": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/flex": "^2.10",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/intl": "^8.0",
        "symfony/lock": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "^8.0",
        "symfony/process": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/requirements-checker": "^2.0",
        "symfony/runtime": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/stimulus-bundle": "^2.30",
        "symfony/string": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/ux-icons": "^2.32",
        "symfony/ux-leaflet-map": "^3.0",
        "symfony/ux-map": "^2.32",
        "symfony/ux-turbo": "^2.32",
        "symfony/ux-twig-component": "^2.32",
        "symfony/validator": "^8.0",
        "symfony/web-link": "^8.0",
        "symfony/yaml": "^8.0",
        "symfonycasts/reset-password-bundle": "^1.22",
        "symfonycasts/verify-email-bundle": "^1.17",
        "twig/extra-bundle": "^3.22",
        "twig/twig": "^3.22"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "requirements-checker": "script"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.0"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/debug-bundle": "^8.0",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/stopwatch": "^8.0",
        "symfony/web-profiler-bundle": "^8.0"
    }
}
